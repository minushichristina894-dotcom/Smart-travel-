PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_travel_planner
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OpenWeatherMap API Key (REQUIRED for real-time weather)
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Python weather decision module
PYTHON_WEATHER_URL=http://localhost:5001/api/analyze

CLIENT_URL=http://localhost:5173

# Brevo API v3 — required for OTP email verification (backend only, never in frontend)
BREVO_API_KEY=your_brevo_api_v3_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Smart Travel Planner
